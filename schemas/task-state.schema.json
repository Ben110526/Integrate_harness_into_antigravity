{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ben110526/Integrate_harness_into_antigravity/schemas/task-state.schema.json",
  "title": "Antigravity Engineering Harness Task State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "status",
    "brief_revision",
    "active_milestone",
    "milestones",
    "acceptance_criteria",
    "source_fingerprint"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
    },
    "workspace": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "in_progress", "completed", "blocked", "cancelled"]
    },
    "brief_revision": {
      "type": "string"
    },
    "active_milestone": {
      "type": "string"
    },
    "max_workers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "default": 3
    },
    "work_items": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "milestone_id", "role", "status", "dependencies", "read_paths", "write_paths"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "milestone_id": {
            "type": "string",
            "pattern": "^M[0-9]+$"
          },
          "role": {
            "type": "string",
            "pattern": "\\S"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "running", "completed", "failed", "blocked", "cancelled"]
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,64}$"
            }
          },
          "read_paths": {
            "$ref": "#/$defs/pathScopes"
          },
          "write_paths": {
            "$ref": "#/$defs/pathScopes"
          },
          "priority": {
            "type": "integer",
            "minimum": -100,
            "maximum": 100,
            "default": 0
          }
        }
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "status"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^M[0-9]+$"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "verified", "skipped"]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ac_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "outcome", "status"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]+$"
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "requirement_source": {
            "type": "string"
          },
          "planned_check": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "verified", "superseded"]
          },
          "superseded_reason": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "source_fingerprint": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/pathScopes/items"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "source_fingerprint_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "scope", "max_files"],
      "properties": {
        "version": {"type": "integer", "const": 2},
        "scope": {"type": "string", "enum": ["explicit", "auto"]},
        "max_files": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ac_id", "command", "cwd", "exit_code"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "ac_id": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          },
          "test_target": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "test_count_status": {
            "type": "string",
            "enum": ["runner-enforced", "unverified"]
          },
          "timestamp": {
            "type": "number"
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "string"
    },
    "updated_at": {
      "type": "number"
    }
  },
  "$defs": {
    "pathScopes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!~)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\:\\u0000-\\u001f*?\\[\\]]+(?:/[^/\\\\:\\u0000-\\u001f*?\\[\\]]+)*$"
      }
    }
  }
}
