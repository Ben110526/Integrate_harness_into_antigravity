{
  "security-gate": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/lifecycle_guard.cmd security",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "project-context": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "./scripts/lifecycle_guard.cmd context",
        "timeout": 5
      }
    ]
  },
  "auto-format": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/lifecycle_guard.cmd format",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "verification-gate": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/verification_gate.cmd post",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "./scripts/verification_gate.cmd stop",
        "timeout": 10
      }
    ]
  }
}
